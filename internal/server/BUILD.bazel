load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = ["server.go"],
    importpath = "github.com/invisible-tech/autopilot-security-sensor/internal/server",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/config",
        "//internal/controller",
        "//internal/types",
        "//internal/version",
        "@com_github_prometheus_client_golang//prometheus/promhttp",
        "@com_github_sirupsen_logrus//:logrus",
    ],
)

go_test(
    name = "server_test",
    srcs = ["server_test.go"],
    embed = [":server"],
    deps = [
        "//internal/config",
        "//internal/controller",
        "//internal/types",
        "@com_github_sirupsen_logrus//:logrus",
    ],
)
