load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

pkg_tar(
    name = "webhook_layer",
    srcs = [":webhook"],
)

oci_image(
    name = "webhook_image",
    base = "@distroless_nonroot_linux_amd64",
    tars = [":webhook_layer"],
    entrypoint = ["/webhook"],
)

oci_push(
    name = "webhook_push",
    image = ":webhook_image",
    repository = "gcr.io/invisible-sre-sandbox/apss-webhook",
)

go_library(
    name = "webhook_lib",
    srcs = ["main.go"],
    importpath = "github.com/invisible-tech/autopilot-security-sensor/cmd/webhook",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/config",
        "//internal/webhook",
        "@com_github_sirupsen_logrus//:logrus",
    ],
)

go_binary(
    name = "webhook",
    embed = [":webhook_lib"],
    visibility = ["//visibility:public"],
)
