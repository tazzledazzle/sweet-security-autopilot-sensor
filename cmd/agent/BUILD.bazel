load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "agent_lib",
    srcs = ["main.go"],
    importpath = "github.com/invisible-tech/autopilot-security-sensor/cmd/agent",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/config",
        "//internal/version",
        "//pkg/monitor",
        "@com_github_sirupsen_logrus//:logrus",
    ],
)

go_binary(
    name = "agent",
    embed = [":agent_lib"],
    visibility = ["//visibility:public"],
)


pkg_tar(
    name = "agent_layer",
    srcs = [":agent"],
)

oci_image(
    name = "agent_image",
    base = "@distroless_nonroot_linux_amd64",
    tars = [":agent_layer"],
    entrypoint = ["/agent"],
)

oci_push(
    name = "agent_push",
    image = ":agent_image",
    repository = "gcr.io/invisible-sre-sandbox/apss-agent",
)