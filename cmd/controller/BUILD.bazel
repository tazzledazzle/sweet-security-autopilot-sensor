load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

pkg_tar(
    name = "controller_layer",
    srcs = [":controller"],
)

oci_image(
    name = "controller_image",
    base = "@distroless_nonroot_linux_amd64",
    tars = [":controller_layer"],
    entrypoint = ["/controller"],
)

oci_push(
    name = "controller_push",
    image = ":controller_image",
    repository = "gcr.io/invisible-sre-sandbox/apss-controller",
)

go_library(
    name = "controller_lib",
    srcs = ["main.go"],
    importpath = "github.com/invisible-tech/autopilot-security-sensor/cmd/controller",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/config",
        "//internal/controller",
        "//internal/server",
        "@com_github_sirupsen_logrus//:logrus",
    ],
)

go_binary(
    name = "controller",
    embed = [":controller_lib"],
    visibility = ["//visibility:public"],
)
